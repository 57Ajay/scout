# systemd unit for Scout (native install).
#
# Installed and templated by deploy/install.sh, which fills in the User and
# HOME. Runs Scout as *you*, so it controls files, git, docker, and kubectl
# with your own permissions — "like you would."
#
# Manual install:
#   sudo cp deploy/scout.service /etc/systemd/system/scout.service
#   sudo nano /etc/systemd/system/scout.service   # set User= and HOME=
#   sudo systemctl daemon-reload && sudo systemctl enable --now scout

[Unit]
Description=Scout — remote VM control plane for AI agents
Documentation=https://github.com/57ajay/scout
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
Environment=HOME=__HOME__
# Ensure docker/kubectl and language toolchains on PATH are found.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:__HOME__/.local/bin
ExecStart=/usr/local/bin/scout --config /etc/scout/scout.yaml
Restart=on-failure
RestartSec=3
# Let long-running commands finish on stop.
TimeoutStopSec=30
KillMode=mixed

# ── Optional hardening (loosen as needed for full VM control) ──
# NoNewPrivileges=true
# ProtectSystem=false   # Scout is meant to write the filesystem; keep false.

[Install]
WantedBy=multi-user.target
