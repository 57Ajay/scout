{$DOMAIN_NAME} {
	reverse_proxy scout:8080 {
		# Stream responses through immediately (no buffering) so Scout's NDJSON
		# command streaming and live process logs flush in real time.
		flush_interval -1
	}

	# Security headers
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options         "DENY"
		Referrer-Policy         "no-referrer"
		Cache-Control           "no-store"
		-Server
	}

	log {
		output stdout
		format console
		level  INFO
	}
}
