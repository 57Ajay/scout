# ── Scout configuration (.env) ──────────────────────────────────────────────
# Used by both Docker Compose and the native Go installer (deploy/deploy.go)

# Bearer token the AI must send. Leave empty to auto-generate (see logs).
# Generate a strong one:  openssl rand -hex 24
AUTH_TOKEN=

# Host port Scout is exposed on (default: 7711).
SCOUT_PORT=7711

# Bind address for Scout server (default: 0.0.0.0).
SCOUT_BIND=0.0.0.0

# Linux system user to run Scout as under systemd (default: $SUDO_USER).
SCOUT_USER=

# Host path mounted READ-WRITE into the container at /work (the agent's workspace).
HOST_MOUNT=./work

# Optional: your kubeconfig, mounted so kubectl works inside the container.
# KUBECONFIG_FILE=/home/you/.kube/config

# Optional: webhook POSTed when a command needs approval (Slack/Discord/ntfy).
# NOTIFY_WEBHOOK=

# Optional: domain for the TLS reverse proxy (docker compose or Caddy under systemd).
DOMAIN_NAME=
