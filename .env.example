# ── Scout container settings (docker compose) ──────────────────────────────

# Bearer token the AI must send. Leave empty to auto-generate (see logs).
# Generate a strong one:  openssl rand -hex 24
AUTH_TOKEN=

# Host port Scout is exposed on.
SCOUT_PORT=7711

# Host path mounted READ-WRITE into the container at /work (the agent's workspace).
HOST_MOUNT=./work

# Optional: your kubeconfig, mounted so kubectl works inside the container.
# KUBECONFIG_FILE=/home/you/.kube/config

# Optional: webhook POSTed when a command needs approval (Slack/Discord/ntfy).
# NOTIFY_WEBHOOK=

# Optional: domain for the TLS reverse proxy (docker compose --profile tls up -d).
DOMAIN_NAME=
